{
  "name": "thread-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json && npm run build:agent",
    "build:agent": "node scripts/build-agent.mjs",
    "build:agent-sea": "node scripts/build-agent-sea.mjs",
    "agent": "node dist/agent/atlas-agent.mjs",
    "start": "npm run build && node dist/server/server/index.js",
    "desktop": "node scripts/desktop.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview",
    "screenshot": "tsx scripts/capture-screenshot.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "express": "^5.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "puppeteer": "^25.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
